{
  "id": "long-context-program",
  "kind": "long-context-program",
  "title": "Normalize one anomalous module in a 120 module program",
  "goal": "Audit a generated 120 module program and repair the single module that breaks the shared scale invariant, without touching the modules that already comply.",
  "successCriteria": [
    "the audit covers every module in the generated program",
    "every module scales linearly by the shared factor, including the anomalous one",
    "modules that already complied are unchanged"
  ],
  "expects": {
    "provider": "anthropic",
    "model": "anthropic/claude-sonnet-4-5",
    "effort": "high"
  },
  "budget": {
    "timeSeconds": 1800,
    "costUsd": 8,
    "tokens": 900000
  },
  "workflow": {
    "type": "chain",
    "maxConcurrency": 1
  },
  "fixture": {
    "generate": {
      "modules": 120,
      "linesPerModule": 60,
      "factor": 7,
      "anomalyIndex": 17
    },
    "contextBytesMin": 200000,
    "mutants": {
      "wrong-module-fix": {
        "category": "context-miss",
        "plan": {
          "fix": "mutant/wrong-module-fix.mjs"
        }
      }
    }
  },
  "gates": [
    {
      "id": "audit-readonly",
      "kind": "diff",
      "category": "review",
      "maxFiles": 0
    },
    {
      "id": "invariant-behavior",
      "category": "behavior",
      "command": [
        "node",
        "--test",
        "checks/invariant.test.mjs"
      ],
      "coverage": [
        "src/**"
      ]
    },
    {
      "id": "anomaly-behavior",
      "category": "behavior",
      "command": [
        "node",
        "--test",
        "checks/anomaly.test.mjs"
      ],
      "coverage": [
        "src/**"
      ]
    }
  ],
  "nodes": [
    {
      "key": "audit",
      "profile": "scout",
      "goal": "Audit every module in the generated program and report coverage of all of them.",
      "plannedChanges": "no file changes; coverage report only",
      "plan": "plan/audit.mjs",
      "include": [
        "src/**"
      ],
      "gateIds": [
        "audit-readonly"
      ],
