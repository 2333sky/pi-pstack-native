{
  "name": "pi-pstack-native",
  "version": "0.6.0-preview.1",
  "description": "pi-pstack-native: pstack semantics rebuilt on Pi's official AgentSession APIs with native durable workflows, worktree isolation, model routing, and scheduling.",
  "type": "module",
  "license": "MIT",
  "author": "2333sky",
  "private": false,
  "keywords": [
    "pi-package",
    "pi-extension",
    "pstack",
    "poteto-mode",
    "agents",
    "workflow",
    "durable",
    "worktree"
  ],
  "files": [
    "src/",
    "skills/",
    "agents/",
    "scripts/",
    "test/",
    "tsconfig.json",
    "CHANGELOG.md",
    "UPSTREAM.json",
    "PARITY.json",
    "PARITY.md",
    "PRD.md",
    "README.md",
    "README.zh-CN.md",
    "CONTRIBUTING.md",
    "SECURITY.md",
    "REVIEW.md",
    "NOTICE.md",
    "LICENSE",
    "examples/",
    "benchmarks/",
    "IMPLEMENTATION.md",
    "ACCEPTANCE.md",
    "docs/DEPENDENCIES.md",
    "docs/README.md",
    "docs/ML-WORKFLOWS.zh-CN.md",
    "docs/REFERENCE.md",
    "docs/PUBLISHING.md",
    "docs/VALIDATION.md",
    "docs/PR-PROTOCOL.md",
    "docs/LIVE-TEST-PLAN.zh-CN.md",
    "docs/WINDOWS-MODEL-TEST.zh-CN.md",
    "docs/UPSTREAM-0.15.17.md",
    "docs/parity.test.mjs",
    "docs/stacked-pr-body.md",
    "docs/upstream-provenance-0.15.17.json",
    "docs/upstream-sync-0.15.17.json",
    "docs/validate-pr.mjs",
    "dist/",
    "tsconfig.build.json",
    "INSTALLATION-CHECK.md",
    "docs/upstream-sync/",
    "vendor/",
    "SEMANTICS.json",
    "docs/PI-SEMANTIC-ADAPTER.md",
    "docs/SEMANTIC-COMPATIBILITY.md",
    "docs/upstream-provenance-0.15.32.json",
    "docs/upstream-provenance-0.15.36.json",
    "docs/upstream-sync-0.15.36.json",
    "docs/upstream-target-0.15.36.json",
    "docs/upstream-dispositions-0.15.36.json",
    "docs/upstream-inventory-0.15.36.json",
    "docs/upstream-upgrade-0.15.36.md",
    "docs/registry-records-0.15.36.json",
    "docs/registry-records-0.15.32.json",
    "docs/PR-41-ALIGNMENT-PLAN.zh-CN.md",
    "docs/upstream-sync-0.15.32.json",
    "docs/upstream-upgrade-0.15.32.md",
    "docs/STATECHART.md",
    "docs/upstream-upgrade-0.15.32.json"
  ],
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "^1.4.0"
  },
  "pi": {
    "extensions": [
      "./src/extension.ts"
    ]
  },
  "scripts": {
    "test": "node --experimental-strip-types --test test/*.test.ts",
    "check:syntax": "node scripts/check-syntax.mjs",
    "check:package": "node scripts/check-package.mjs",
    "check:parity": "node scripts/check-parity.mjs",
    "check:inventory": "node scripts/check-inventory.mjs",
    "review": "node scripts/review.mjs",
    "check": "npm run check:syntax && npm run check:package && npm run check:parity && npm run check:semantics && npm run check:inventory && npm run check:contracts && npm run check:records && npm run check:playbooks && npm run test:upstream && npm test && npm run review",
    "check:playbooks": "node scripts/check-e2e.mjs playbooks",
    "check:pr-body": "node docs/validate-pr.mjs",
    "prepack": "npm run check:release",
    "sync:upstream": "node scripts/sync-upstream.mjs",
    "check:types": "tsc --noEmit -p tsconfig.json",
    "check:host": "node scripts/smoke-host.mjs",
    "benchmark": "node scripts/benchmark.mjs",
    "build": "node scripts/build.mjs",
    "benchmark:smoke": "node scripts/check-benchmark.mjs",
    "test:e2e:offline": "node scripts/check-e2e.mjs offline",
    "test:e2e:fake": "node scripts/check-e2e.mjs fake",
    "check:e2e": "npm run test:e2e:offline && npm run test:e2e:fake",
    "test:live": "node --experimental-strip-types scripts/e2e-live.mjs",
    "smoke:installed": "node scripts/smoke-install.mjs",
    "check:release": "npm run check && npm run check:types && npm run check:e2e && npm run build && npm run check:host && npm run benchmark:smoke && npm run smoke:installed",
    "upstream:inventory": "node scripts/upstream/cli.mjs inventory",
    "upstream:scan": "node scripts/upstream/cli.mjs scan",
    "upstream:plan": "node scripts/upstream/cli.mjs plan",
    "upstream:verify": "node scripts/upstream/cli.mjs verify",
    "upstream:prepare": "node scripts/upstream/cli.mjs prepare",
    "upstream:propose": "node scripts/upstream/cli.mjs propose",
    "test:upstream": "node --experimental-strip-types --test scripts/upstream/*.test.mjs",
    "check:plan": "node scripts/check-plan.mjs",
    "check:contracts": "node --experimental-strip-types scripts/check-contracts.mjs",
    "upstream:contracts": "node --experimental-strip-types scripts/check-contracts.mjs --write",
    "check:records": "node scripts/check-records.mjs",
    "registry:records": "node scripts/check-records.mjs --write",
    "check:semantics": "node --experimental-strip-types scripts/check-semantics.mjs",
    "test:semantics": "node --experimental-strip-types --test test/semantic-compatibility.test.ts",
    "smoke:semantics:real": "node --experimental-strip-types scripts/semantics/real-pi-smoke.mjs",
    "test:statechart": "node scripts/check-statechart.mjs"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "1.4.0",
    "@types/node": "^22.0.0",
    "fast-check": "4.5.3",
    "typescript": "^5.8.0"
  },
  "bin": {
    "pstack-runner": "./dist/runner/cli.mjs"
  },
  "exports": {
    ".": {
      "types": "./dist/api.d.ts",
      "import": "./dist/api.js"
    },
    "./package.json": "./package.json"
  }
}
